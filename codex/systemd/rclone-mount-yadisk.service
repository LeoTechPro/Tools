[Unit]
Description=Rclone mount for Yandex Disk
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/usr/bin/mkdir -p %h/vfs/intdata/yadisk %h/.cache/rclone-intdata %h/.local/state/intdata-tools/cloud-access/log
ExecStart=/usr/bin/rclone mount yadisk: %h/vfs/intdata/yadisk --config %h/.config/rclone/rclone.conf --cache-dir %h/.cache/rclone-intdata --vfs-cache-mode writes --vfs-cache-max-size 512M --log-file %h/.local/state/intdata-tools/cloud-access/log/yadisk.log
ExecStop=/usr/bin/fusermount3 -u %h/vfs/intdata/yadisk
Restart=on-failure
RestartPreventExitStatus=3
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=default.target
