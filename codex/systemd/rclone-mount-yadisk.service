[Unit]
Description=Rclone mount for Yandex Disk
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=RCLONE_CONFIG=/home/dev/int/tools/.runtime/cloud-access/rclone.conf
ExecStartPre=/home/dev/int/tools/codex/cloud_access.sh ensure-dirs
ExecStart=/home/dev/int/tools/codex/cloud_access.sh mount yadisk /home/dev/int/cloud/yadisk
ExecStop=/home/dev/int/tools/codex/cloud_access.sh umount /home/dev/int/cloud/yadisk
Restart=on-failure
RestartPreventExitStatus=3
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=default.target
