[Unit]
Description=Rclone mount for Google Drive
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/usr/bin/mkdir -p %h/vfs/intdata/gdrive %h/.cache/rclone-intdata %h/.local/state/intdata-tools/cloud-access/log
ExecStart=/usr/bin/rclone mount gdrive: %h/vfs/intdata/gdrive --config %h/.config/rclone/rclone.conf --cache-dir %h/.cache/rclone-intdata --vfs-cache-mode writes --vfs-cache-max-size 512M --log-file %h/.local/state/intdata-tools/cloud-access/log/gdrive.log
ExecStop=/usr/bin/fusermount3 -u %h/vfs/intdata/gdrive
Restart=on-failure
RestartPreventExitStatus=3
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=default.target
